<?xml version="1.0" encoding="UTF-8"?>
<!-- zare_nk_050413_okk(1)(khatte tarife xml bayad avvalin khat basheh) -->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="ReverseProxyToNext">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://localhost:3002/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>